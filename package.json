{
  "name": "boost-html",
  "version": "0.1.0",
  "description": "Progressive enhancement for HTML: hx-boost-style link and form navigation with body swaps, history support and an NProgress bar.",
  "keywords": [
    "htmx",
    "hx-boost",
    "boost",
    "progressive-enhancement",
    "pjax",
    "navigation",
    "nprogress",
    "dom"
  ],
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "dist/*"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "bench": "npm run build && node benchmarks/run.mjs",
    "size": "size-limit",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run size",
    "demo": "npm run build && node demo/server.mjs",
    "demo:server": "node demo/server.mjs",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "nprogress": "^0.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@size-limit/file": "^14.3.0",
    "@types/node": "^26.6.6",
    "@types/nprogress": "^0.2.3",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "size-limit": "^14.3.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=18"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "not dead"
  ],
  "size-limit": [
    {
      "name": "ESM bundle",
      "path": "dist/index.js",
      "limit": "5 kB",
      "gzip": true
    },
    {
      "name": "IIFE bundle",
      "path": "dist/index.global.js",
      "limit": "7 kB",
      "gzip": true
    }
  ]
}
