{
  "name": "boost-html",
  "version": "0.1.0",
  "description": "Progressive enhancement for HTML: hx-boost-style link and form navigation with body swaps, history support and a native progress bar.",
  "keywords": [
    "htmx",
    "hx-boost",
    "boost",
    "progressive-enhancement",
    "pjax",
    "navigation",
    "dom"
  ],
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "docs/API.md",
    "docs/SECURITY.md"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs",
    "./dist/index.global.js"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "npm run test:unit",
    "test:e2e": "npm run test:integration",
    "bench": "npm run build && node benchmarks/profile.mjs",
    "bench:prefetch": "npm run build && node benchmarks/prefetch.mjs",
    "bench:cache": "npm run build && node benchmarks/cache.mjs",
    "size": "size-limit",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run size && npm run verify:package",
    "demo": "npm run build && node demo/server.mjs",
    "demo:server": "node demo/server.mjs",
    "prepublishOnly": "npm run check",
    "test:unit": "vitest run --coverage",
    "test:browser": "playwright test",
    "test:integration": "npm run build && npm run test:browser",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@size-limit/file": "^14.3.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "size-limit": "^14.3.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=18"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "not dead"
  ],
  "size-limit": [
    {
      "name": "Core ESM shared bundle (5 KB goal pending)",
      "path": "dist/chunk-*.js",
      "limit": "8.6 kB",
      "gzip": true
    },
    {
      "name": "Optional prefetch ESM chunk",
      "path": "dist/engine-*.js",
      "limit": "3.7 kB",
      "gzip": true
    },
    {
      "name": "Optional navigation cache ESM chunk",
      "path": "dist/navigation-cache-*.js",
      "limit": "2.2 kB",
      "gzip": true
    },
    {
      "name": "Browser ESM entry",
      "path": "dist/index.js",
      "limit": "1 kB",
      "gzip": true
    },
    {
      "name": "Core IIFE bundle",
      "path": "dist/core.global.js",
      "limit": "12.5 kB",
      "gzip": true
    },
    {
      "name": "Browser IIFE bundle",
      "path": "dist/index.global.js",
      "limit": "12.6 kB",
      "gzip": true
    }
  ]
}
